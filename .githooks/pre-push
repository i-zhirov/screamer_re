#!/bin/sh
# Run the project checks before every push.
#
# Enable the hook once per clone:
#     git config core.hooksPath .githooks
#
# The full check needs the installed game and DOSBox-X.  When either is missing,
# the hook reports the skip and passes.  Set SCREAMER_GAME_DIR to use another
# game directory.

set -e

GAME_DIR="${SCREAMER_GAME_DIR:-$HOME/Documents/Screamer.app/Contents/Resources/game}"

echo "pre-push: syntax gate"
python3 -m py_compile \
    tools/le.py \
    tools/inventory.py \
    tools/extract_cd_image.py \
    tools/dosboxx_control.py \
    tools/entry_probe.py \
    tools/gfx_container.py \
    tools/pipeline_check.py

if [ ! -d "$GAME_DIR" ]; then
    echo "pre-push: full check skipped: no game directory at $GAME_DIR"
    exit 0
fi

if ! command -v dosbox-x >/dev/null 2>&1; then
    echo "pre-push: full check skipped: dosbox-x is not on PATH"
    exit 0
fi

if command -v nix >/dev/null 2>&1; then
    echo "pre-push: full check in the Nix dev shell"
    nix develop --command python3 tools/pipeline_check.py --game-dir "$GAME_DIR"
else
    echo "pre-push: full check"
    python3 tools/pipeline_check.py --game-dir "$GAME_DIR"
fi
