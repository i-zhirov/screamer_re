# Read the member names at the race start.
#
# The member open FUN_0004C08D runs at the linear 0x20E08D when the module base
# is 0x1C2000.  The script waits for the demo, presses Enter to leave it, sets
# the linear breakpoint, and reads the member name in EBX at the first hit.
break
clear
exec RUN
sleep 60
key \r
sleep 3
exec BPLM 0x20E08D
exec BPLIST
exec RUN
sleep 15
break
read EAX EBX ECX EDX ESI EDI EBP EIP
exec MEMDUMPBIN 0150:2F4000 2000 NAMES1.BIN
exec BPLIST
exec RUN
sleep 5
break
read EAX EBX ECX EDX ESI EDI EBP EIP
exec MEMDUMPBIN 0150:2F4000 2000 NAMES2.BIN
exec BPLIST
exec BPDEL *
exec RUN
