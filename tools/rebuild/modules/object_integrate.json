{
  "exe": "ointmod.exe",
  "map": "object_integrate.map",
  "name": "object_integrate",
  "run": {
    "command": "ointmod.exe > oint_out.txt",
    "expect": [
      "0",
      "1",
      "2",
      "3",
      "4",
      "5",
      "6",
      "7",
      "D"
    ],
    "output": "oint_out.txt",
    "timeout": 180
  },
  "sources": [
    {
      "compiler": "wcc386",
      "file": "object_integrate.c",
      "flags": [
        "-of+"
      ]
    },
    {
      "compiler": "wasm",
      "file": "object_integrate_fpu.asm"
    },
    {
      "compiler": "wcc386",
      "file": "object_integrate_main.c"
    }
  ]
}
