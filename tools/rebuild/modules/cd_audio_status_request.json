{
  "exe": "cdstat.exe",
  "map": "cdstat.map",
  "name": "cd_audio_status_request",
  "run": {
    "command": "cdstat.exe > cdstat.txt",
    "expect": [
      "0",
      "1",
      "2",
      "3",
      "4",
      "D"
    ],
    "output": "cdstat.txt",
    "timeout": 180
  },
  "sources": [
    {
      "compiler": "wcc386",
      "file": "cd_audio_status_request.c"
    },
    {
      "compiler": "wcc386",
      "file": "cd_audio_status_request_main.c"
    }
  ],
  "toolchain": "v2"
}
