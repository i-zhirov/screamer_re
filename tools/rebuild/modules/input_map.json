{
  "exe": "inpmod.exe",
  "map": "input_map.map",
  "name": "input_map",
  "run": {
    "command": "inpmod.exe > inp_out.txt",
    "expect": [
      "0",
      "1",
      "2",
      "3",
      "4",
      "5",
      "6",
      "7",
      "D"
    ],
    "output": "inp_out.txt",
    "timeout": 180
  },
  "sources": [
    {
      "compiler": "wcc386",
      "file": "input_map.c",
      "flags": [
        "-of+"
      ]
    },
    {
      "compiler": "wcc386",
      "file": "input_map_main.c"
    }
  ]
}
