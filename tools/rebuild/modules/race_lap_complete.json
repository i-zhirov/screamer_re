{
  "exe": "rlap.exe",
  "map": "race_lap_complete.map",
  "name": "race_lap_complete",
  "run": {
    "command": "rlap.exe > rlap.txt",
    "expect": [
      "0",
      "1",
      "2",
      "3",
      "4",
      "5",
      "6",
      "7",
      "8",
      "D"
    ],
    "output": "rlap.txt",
    "timeout": 180
  },
  "sources": [
    {
      "compiler": "wcc386",
      "file": "race_lap_complete.c",
      "flags": [
        "-of+"
      ]
    },
    {
      "compiler": "wasm",
      "file": "race_lap_complete_fpu.asm"
    },
    {
      "compiler": "wcc386",
      "file": "race_lap_complete_main.c"
    }
  ]
}
