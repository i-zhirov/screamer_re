  "map": "quit_confirm_screen.map",
  "name": "quit_confirm_screen",
  "run": {
    "command": "qconf.exe > qconf.txt",
    "expect": [
      "0",
      "1",
      "2",
      "3",
      "4",
      "5",
      "6",
      "7",
      "8",
      "D"
