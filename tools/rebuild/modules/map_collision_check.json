{
  "exe": "mcolchck.exe",
  "map": "map_collision_check.map",
  "name": "map_collision_check",
  "run": {
    "command": "mcolchck.exe > mcolchck.txt",
    "expect": [
      "0",
      "1",
      "2",
      "3",
      "4",
      "5",
      "6",
      "7",
      "8",
      "D"
    ],
    "output": "mcolchck.txt",
    "timeout": 180
  },
  "sources": [
    {
      "compiler": "wcc386",
      "file": "map_collision_check.c",
      "flags": [
        "-of+"
      ]
    },
    {
      "compiler": "wcc386",
      "file": "map_collision_check_main.c"
    }
  ]
}
