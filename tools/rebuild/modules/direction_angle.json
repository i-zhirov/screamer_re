{
  "exe": "dirang.exe",
  "map": "direction_angle.map",
  "name": "direction_angle",
  "run": {
    "command": "dirang.exe > dirang.txt",
    "expect": [
      "0",
      "1",
      "2",
      "3",
      "4",
      "5",
      "6",
      "7",
      "8",
      "D"
    ],
    "output": "dirang.txt",
    "timeout": 180
  },
  "sources": [
    {
      "compiler": "wcc386",
      "file": "direction_angle.c",
      "flags": [
        "-of+"
      ]
    },
    {
      "compiler": "wasm",
      "file": "direction_angle_fpu.asm"
    },
    {
      "compiler": "wcc386",
      "file": "direction_angle_main.c"
    }
  ]
}
