{
  "exe": "msrtmod.exe",
  "map": "memset_runtime.map",
  "name": "memset_runtime",
  "run": {
    "command": "msrtmod.exe > msrt_out.txt",
    "expect": [
      "V",
      "D"
    ],
    "output": "msrt_out.txt",
    "timeout": 180
  },
  "sources": [
