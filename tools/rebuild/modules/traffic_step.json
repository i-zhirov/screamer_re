{
  "exe": "trst.exe",
  "map": "traffic_step.map",
  "name": "traffic_step",
  "run": {
    "command": "trst.exe > trst.txt",
    "expect": [
      "0",
      "1",
      "2",
      "3",
      "4",
      "5",
      "6",
      "7",
      "D"
    ],
    "output": "trst.txt",
    "timeout": 180
  },
  "sources": [
    {
      "compiler": "wcc386",
      "file": "traffic_step.c",
      "flags": [
        "-of+"
      ]
    },
    {
      "compiler": "wcc386",
      "file": "traffic_step_main.c"
    }
  ]
}
