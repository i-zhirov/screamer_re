  },
  "sources": [
    {
      "compiler": "wcc386",
      "file": "car_collision_step.c",
      "flags": [
        "-of+"
      ]
    },
    {
      "compiler": "wcc386",
      "file": "car_collision_step_main.c"
    }
  ]
}
