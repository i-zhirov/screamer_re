{
  "exe": "ccstep.exe",
  "map": "car_collision_step.map",
  "name": "car_collision_step",
  "run": {
    "command": "ccstep.exe > ccstep.txt",
    "expect": [
      "0",
      "1",
      "2",
      "3",
      "4",
      "D"
    ],
    "output": "ccstep.txt",
