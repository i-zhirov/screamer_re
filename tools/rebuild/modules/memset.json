{
  "exe": "memmod.exe",
  "map": "memset.map",
  "name": "memset",
  "run": {
    "command": "memmod.exe > mem_out.txt",
    "expect": [
      "V",
      "D"
    ],
    "output": "mem_out.txt",
    "timeout": 180
  },
  "sources": [
