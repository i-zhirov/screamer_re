{
  "exe": "msimod.exe",
  "map": "mouse_init.map",
  "name": "mouse_init",
  "run": {
    "command": "msimod.exe > msi_out.txt",
    "expect": [
      "0",
      "1",
      "2",
      "3",
      "4",
      "D"
    ],
