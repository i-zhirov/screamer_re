    "timeout": 180
  },
  "sources": [
    {
      "compiler": "wcc386",
      "file": "mouse_init.c",
      "flags": [
        "-of+"
      ]
    },
    {
      "compiler": "wcc386",
      "file": "mouse_init_main.c"
    }
  ]
}
