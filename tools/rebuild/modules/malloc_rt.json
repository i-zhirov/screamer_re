{
  "exe": "mlcmod.exe",
  "map": "malloc_rt.map",
  "name": "malloc_rt",
  "run": {
    "command": "mlcmod.exe > mlc_out.txt",
    "expect": [
      "0",
      "1",
      "2",
      "3",
      "4",
      "5",
      "6",
      "7",
      "8",
      "D"
    ],
    "output": "mlc_out.txt",
    "timeout": 180
  },
  "sources": [
    {
      "compiler": "wcc386",
      "file": "malloc_rt.c",
      "flags": [
        "-of+"
      ]
    },
    {
      "compiler": "wcc386",
      "file": "malloc_rt_main.c"
    }
  ]
}
