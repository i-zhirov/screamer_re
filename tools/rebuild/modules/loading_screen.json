  },
  "sources": [
    {
      "compiler": "wcc386",
      "file": "loading_screen.c",
      "flags": [
        "-of+"
      ]
    },
    {
      "compiler": "wcc386",
      "file": "loading_screen_main.c"
    }
  ]
}
