{
  "exe": "ldsmod.exe",
  "map": "loading_screen.map",
  "name": "loading_screen",
  "run": {
    "command": "ldsmod.exe > lds_out.txt",
    "expect": [
      "0",
      "1",
      "2",
      "3",
      "4",
      "5",
      "6",
      "7",
      "8",
      "D"
