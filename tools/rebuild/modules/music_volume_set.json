{
  "exe": "mvol.exe",
  "map": "music_volume_set.map",
  "name": "music_volume_set",
  "run": {
    "command": "mvol.exe > mvol.txt",
    "expect": [
      "0",
      "1",
      "2",
      "3",
      "4",
      "5",
      "D"
    ],
    "output": "mvol.txt",
    "timeout": 180
  },
  "sources": [
    {
      "compiler": "wcc386",
      "file": "music_volume_set.c",
      "flags": [
        "-of+"
      ]
    },
    {
      "compiler": "wcc386",
      "file": "music_volume_set_main.c"
    }
  ]
}
