  },
  "sources": [
    {
      "compiler": "wcc386",
      "file": "spatial_grid_relocate.c",
      "flags": [
        "-of+"
      ]
    },
    {
      "compiler": "wcc386",
      "file": "spatial_grid_relocate_main.c"
    }
  ]
}
