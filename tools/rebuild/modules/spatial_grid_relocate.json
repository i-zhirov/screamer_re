{
  "exe": "sgridrel.exe",
  "map": "spatial_grid_relocate.map",
  "name": "spatial_grid_relocate",
  "run": {
    "command": "sgridrel.exe > sgridrel.txt",
    "expect": [
      "0",
      "1",
      "2",
      "3",
      "D"
    ],
