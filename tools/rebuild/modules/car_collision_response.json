{
  "exe": "ccr.exe",
  "map": "car_collision_response.map",
  "name": "car_collision_response",
  "run": {
    "command": "ccr.exe > ccr_out.txt",
    "expect": [
      "0",
      "1",
      "2",
      "3",
      "4",
      "5",
      "6",
      "7",
      "D"
