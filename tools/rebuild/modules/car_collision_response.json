  },
  "sources": [
    {
      "compiler": "wcc386",
      "file": "car_collision_response.c",
      "flags": [
        "-of+"
      ]
    },
    {
      "compiler": "wasm",
      "file": "car_collision_response_fpu.asm"
    },
    {
      "compiler": "wcc386",
      "file": "car_collision_response_main.c"
    }
  ]
}
