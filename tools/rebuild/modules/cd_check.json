{
  "exe": "cdcheck.exe",
  "map": "cdcheck.map",
  "name": "cd_check",
  "run": {
    "command": "cdcheck.exe > cdcheck.txt",
    "expect": [
      "0",
      "1",
      "2",
      "3",
      "4",
      "5",
      "6",
      "7",
      "D"
    ],
    "output": "cdcheck.txt",
    "timeout": 180
  },
  "sources": [
    {
      "compiler": "wcc386",
      "file": "cd_check.c",
      "flags": [
        "-of+"
      ]
    },
    {
      "compiler": "wcc386",
      "file": "cd_check_main.c"
    }
  ]
}
