{
  "exe": "spline.exe",
  "map": "spline_interpolate.map",
  "name": "spline_interpolate",
  "run": {
    "command": "spline.exe > spln_out.txt",
    "expect": [
      "0",
      "1",
      "2",
      "3",
      "4",
      "5",
      "6",
      "7",
      "8",
      "D"
    ],
    "output": "spln_out.txt",
    "timeout": 180
  },
  "sources": [
    {
      "compiler": "wcc386",
      "file": "spline_interpolate.c",
      "flags": [
        "-of+"
      ]
    },
    {
      "compiler": "wasm",
      "file": "spline_interpolate_fpu.asm"
    },
    {
      "compiler": "wcc386",
      "file": "spline_interpolate_main.c"
    }
  ]
}
