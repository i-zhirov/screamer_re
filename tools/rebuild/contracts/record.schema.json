{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rebuild function record",
  "description": "One record per function of STARTH.EXE. The file name is the module linear address, for example functions/0x300ec.json. An optional field is absent, never null.",
  "type": "object",
  "additionalProperties": false,
  "required": ["address", "status", "checks", "evidence", "notes"],
  "properties": {
    "address": {
      "type": "string",
      "pattern": "^0x[0-9a-f]+$",
      "description": "The module linear address. Equals the file name."
    },
    "object_offset": {
      "type": "string",
      "pattern": "^0x[0-9a-f]+$",
      "description": "The object offset from le.py."
    },
    "size": {
      "type": "integer",
      "minimum": 0,
      "description": "The byte count of the original body."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "The recovered name. Absent when the candidate is unnamed."
    },
    "role": {
      "type": "string",
      "minLength": 1,
      "description": "One sentence."
    },
    "status": {
      "enum": ["unknown", "not_a_function", "named", "rebuilt", "matching", "verified"],
      "description": "The status ladder."
    },
    "confidence": {
      "enum": ["observed", "derived", "inferred"]
    },
    "section": {
      "type": "string",
      "minLength": 1,
      "description": "A section name of program-map.md."
    },
    "module": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "description": "The name of a module record."
    },
    "symbol": {
      "type": "string",
      "minLength": 1,
      "description": "The linker map symbol, for example free_."
    },
    "count": {
      "type": "integer",
      "minimum": 1,
      "description": "The instruction count of the identity check, passed to diff_module.py --count. Set when the body sweep runs past the end of the function."
    },
    "checks": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["build", "identity", "behavior"] }
    },
    "evidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidence" }
    },
    "notes": {
      "type": "array",
      "items": { "$ref": "#/$defs/note" }
    },
    "result": { "$ref": "#/$defs/result" }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "text"],
      "properties": {
        "kind": {
          "enum": ["command", "finding", "file", "note"],
          "description": "A command, a heading of findings.md, a repository path, or one sentence."
        },
        "text": { "type": "string", "minLength": 1 }
      }
    },
    "note": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "text"],
      "properties": {
        "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "text": { "type": "string", "minLength": 1 }
      }
    },
    "result": {
      "type": "object",
      "description": "The last run. The store never holds a hand-entered percentage.",
      "additionalProperties": false,
      "required": ["date", "command", "tool", "source_digest", "checks"],
      "properties": {
        "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "command": { "type": "string", "minLength": 1 },
        "tool": { "type": "string", "minLength": 1 },
        "source_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "checks": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/check_result" }
        }
      }
    },
    "check_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "detail"],
      "properties": {
        "verdict": { "enum": ["pass", "fail"] },
        "detail": { "type": "string", "minLength": 1 },
        "instructions_equal": { "type": "integer", "minimum": 0 },
        "instructions_total": { "type": "integer", "minimum": 0 },
        "bytes_equal": { "type": "integer", "minimum": 0 },
        "bytes_total": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
