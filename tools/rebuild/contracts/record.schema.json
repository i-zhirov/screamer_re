{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rebuild function record",
  "description": "One record per function of STARTH.EXE. The file name is the module linear address, for example functions/0x300ec.json. An optional field is absent, never null.",
  "type": "object",
  "additionalProperties": false,
  "required": ["address", "provenance", "status", "checks", "evidence", "notes"],
  "properties": {
    "address": {
      "type": "string",
      "pattern": "^0x[0-9a-f]+$",
      "description": "The module linear address. Equals the file name."
    },
    "object_offset": {
      "type": "string",
      "pattern": "^0x[0-9a-f]+$",
      "description": "The object offset from le.py."
    },
    "size": {
      "type": "integer",
      "minimum": 0,
      "description": "The distance to the next entry; it bounds the identity check."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "The recovered name. Absent when the candidate is unnamed."
    },
    "role": {
      "type": "string",
      "minLength": 1,
      "description": "One sentence."
    },
    "status": {
      "enum": ["unknown", "not_a_function", "named", "rebuilt", "matching", "verified"],
      "description": "The status ladder."
    },
    "provenance": {
      "enum": ["game", "library", "compiler_helper", "not_a_function", "data"],
      "description": "The origin class of the record."
    },
    "confidence": {
      "enum": ["observed", "derived", "inferred"]
    },
    "section": {
      "type": "string",
      "minLength": 1,
      "description": "A section name of program-map.md."
    },
    "module": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "description": "The name of a module record."
    },
    "symbol": {
      "type": "string",
      "minLength": 1,
      "description": "The linker map symbol, for example free_."
    },
    "count": {
      "type": "integer",
      "minimum": 1,
      "description": "The instruction count of the identity check, passed to diff_module.py --count. The record size wins over the count when both are present, because --original-end bounds the original body. Set when the body sweep runs past the end of the function."
    },
    "implementation": {
      "enum": ["c", "assembly"],
      "description": "The source language of the rebuilt function. Absent when the record does not mark a language."
    },
    "checks": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["build", "identity", "behavior"] }
    },
    "evidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidence" }
    },
    "notes": {
      "type": "array",
      "items": { "$ref": "#/$defs/note" }
    },
    "result": { "$ref": "#/$defs/result" },
    "library": {
      "type": "object",
      "description": "The original library object of a library-verified record.",
      "additionalProperties": false,
      "required": ["file", "sha256", "module", "symbol", "object_sha256"],
      "properties": {
        "file": { "type": "string", "minLength": 1 },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "module": { "type": "string", "minLength": 1 },
        "symbol": { "type": "string", "minLength": 1 },
        "object_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "text"],
      "properties": {
        "kind": {
          "enum": ["command", "finding", "file", "note"],
          "description": "A command, a heading of findings.md, a repository path, or one sentence."
        },
        "text": { "type": "string", "minLength": 1 }
      }
    },
    "note": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "text"],
      "properties": {
        "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "text": { "type": "string", "minLength": 1 }
      }
    },
    "result": {
      "type": "object",
      "description": "The last run. The store never holds a hand-entered percentage.",
      "additionalProperties": false,
      "required": ["date", "command", "tool", "source_digest", "fingerprint", "checks"],
      "properties": {
        "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "command": { "type": "string", "minLength": 1 },
        "tool": { "type": "string", "minLength": 1 },
        "source_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "description": "The SHA-256 over every input of the declared checks: the module recipe, the module sources, the shared harness sources, the record fields, the strict mode and the toolchain, the participating tools, the original image, and the built artifacts. Written by run.py."
        },
        "checks": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/check_result" }
        },
        "mode": { "$ref": "#/$defs/mode" }
      }
    },
    "check_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "detail"],
      "properties": {
        "verdict": { "enum": ["pass", "fail"] },
        "detail": { "type": "string", "minLength": 1 },
        "match": {
          "enum": ["exact-bytes", "exact-relocations", "same-shape", "same-mnemonics", "different"],
          "description": "The identity result class. Absent on a result that predates the field."
        },
        "instructions_equal": { "type": "integer", "minimum": 0 },
        "instructions_total": { "type": "integer", "minimum": 0 },
        "bytes_equal": { "type": "integer", "minimum": 0 },
        "bytes_total": { "type": "integer", "minimum": 0 }
      }
    },
    "mode": {
      "type": "object",
      "description": "The mode of the run that wrote the result.",
      "additionalProperties": false,
      "required": ["strict", "toolchain", "runtime"],
      "properties": {
        "strict": { "type": "boolean" },
        "toolchain": { "enum": ["v2", "watcom10"] },
        "runtime": { "enum": ["run", "skip"] }
      }
    }
  }
}
